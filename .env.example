# Copy to .env and edit for your campus/utility contract. All values have
# working defaults in backend/app/config.py if you skip this file.

DATABASE_URL=postgresql+asyncpg://campus:campus@db:5432/campus_energy
MQTT_BROKER=mqtt
MQTT_PORT=1883

RATE_OFFPEAK_PER_KWH=0.11
RATE_PEAK_PER_KWH=0.27
PEAK_HOURS_START=7
PEAK_HOURS_END=22
DEMAND_CHARGE_PER_KW=14.5

GRID_CARBON_INTENSITY_DAY_KG_PER_KWH=0.38
GRID_CARBON_INTENSITY_NIGHT_KG_PER_KWH=0.21
